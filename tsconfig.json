{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // No ambient type packages. Nothing in `src` or `tests` touches a Node
    // API — this library speaks to a browser through Playwright's own types
    // and the tests import vitest explicitly — and leaving this unset lets
    // tsc pull in whatever `@types/*` it finds walking up from here, which is
    // how `"types": ["node"]` typechecked for a year on a workstation with
    // @types/node installed in $HOME while failing on every clean checkout.
    "types": []
  },
  "include": ["src", "tests"]
}
